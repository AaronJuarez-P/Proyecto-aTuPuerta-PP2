# --- Base de datos ---
# DB_* desde la semana 14. Los nombres viejos (HOST, DATABASE, USER, PASSWORD) siguen
# andando, pero en Mac y Linux USER es una variable del sistema y dotenv no la pisa:
# con USER=root la conexion salia con el usuario de la computadora.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aTuPuerta
DB_USER=root
DB_PASSWORD=
JWT_SECRET=ClaveSecretaProyecto2026
JWT_EXPIRES_IN=8h
PORT=4000

# --- Pagos / MercadoPago (semana 6, CU07) ---
# mock    = no llama a MercadoPago, se prueba con POST /api/pagos/simular
# sandbox = usa el SDK real con credenciales de prueba (token TEST-...)
MP_MODO=mock
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL publica del backend. Con MP_MODO=sandbox tiene que ser la de ngrok,
# porque MercadoPago necesita poder llegar al webhook desde afuera.
URL_PUBLICA=http://localhost:4000

# --- Geolocalizacion / Mapbox (semana 9, CU21, CU22) ---
# mock = no llama a Mapbox. Geocodifica de forma deterministica (la misma direccion
#        da siempre el mismo punto) y estima la distancia con Haversine.
#        Alcanza para probar y demostrar todo el flujo, sin token ni tarjeta.
# real = usa Directions API v5 + Geocoding API v6 con el token de abajo.
MAPS_MODO=mock
MAPS_ACCESS_TOKEN=
# Guardar las coordenadas en la base requiere derechos de almacenamiento permanente,
# que cuestan mas por request y piden una tarjeta cargada en la cuenta de Mapbox.
# En false, la geocodificacion es "temporary" y no habilita a persistir resultados.
MAPS_GEOCODING_PERMANENT=false
# Centro y radio del pseudo-geocodificador del modo mock (Santo Tome, Santa Fe)
MAPS_CENTRO_LAT=-31.6667
MAPS_CENTRO_LNG=-60.7667
MAPS_RADIO_MOCK_KM=5
# Velocidad promedio del repartidor, para estimar el tiempo de viaje sin Mapbox
MAPS_VELOCIDAD_KMH=25
# Factor calle / linea recta que se le aplica al Haversine: la calle nunca es
# la linea recta entre dos puntos
MAPS_FACTOR_RUTA=1.3
# Distancia que se usa cuando no hay NI coordenadas para estimar
MAPS_DISTANCIA_FALLBACK_KM=3

# --- Comision del repartidor (semana 9) ---
# comision = COMISION_BASE + COMISION_POR_KM * distancia_km
COMISION_BASE=500
COMISION_POR_KM=80

# --- Seguimiento en tiempo real (semana 10, CU08, CU26) ---
# Origenes permitidos para el handshake del socket. Socket.IO NO hereda el cors() de
# Express: sin esto, un front servido desde otro puerto falla al conectarse con un
# error que ni siquiera menciona CORS. En desarrollo, *.
SOCKET_ORIGEN=*
# Cada cuantos pings del repartidor se le vuelve a pedir la ruta real a Mapbox.
# Entre refrescos el ETA se reescala localmente, que es gratis.
SEGUIMIENTO_PINGS_REFRESCO=10
# Tope de tiempo entre refrescos. La condicion de pings sola no alcanza: un repartidor
# que pingea cada 30s tardaria 5 minutos en refrescar.
SEGUIMIENTO_MINUTOS_REFRESCO=2
# Tope de pedidos con sesion de seguimiento viva en memoria
SEGUIMIENTO_SESIONES_MAX=200

# --- Notificaciones push (semana 11, CU27) ---
# Claves VAPID: se generan una sola vez con  npx web-push generate-vapid-keys
# Sin ellas el push queda apagado y el servidor arranca igual: las notificaciones se
# siguen guardando en la base y se leen con GET /api/notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ATuPuerta@gmail.org

# --- Seguridad (semana 14) ---
# Origenes que pueden llamar a la API desde un navegador, separados por coma. Vacio =
# cualquiera (el servidor lo avisa al arrancar). El de Vite es http://localhost:5173.
# El socket usa este mismo valor si SOCKET_ORIGEN no esta definido.
CORS_ORIGEN=http://localhost:5173
# Limites por IP en una ventana de RATE_LIMIT_VENTANA_MINUTOS
RATE_LIMIT_VENTANA_MINUTOS=15
# Pedidos totales a /api: generoso, alcanza para correr las guias de Postman enteras
RATE_LIMIT_MAX=1000
# Intentos FALLIDOS de login, registro y cambio de contraseña
RATE_LIMIT_LOGIN_MAX=10
# Solo detras de un proxy (ngrok, un despliegue): cuantos saltos de proxy creerle
# para sacar la IP real del cliente. En local, vacio.
TRUST_PROXY=
